# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias cls='printf "\033c"'

# ls — requires eza (pacman: eza / dnf: eza)
if command -v eza &>/dev/null; then
  alias ls='eza'
  alias la='eza -a'
  alias ll='eza -alF --git'
  alias lt='eza --tree --level=2'
fi

# bat as cat replacement (pacman: bat / dnf: bat)
command -v bat &>/dev/null && alias cat='bat'

# Git
alias g='git status'
alias gf='git fetch'
alias ga='git add .'
alias gc='git commit -m'
alias gs='git stash -u -m'
alias gsa='git stash apply'
alias gsl='git stash list'
alias gco='git checkout'
alias gpush='git push'
alias gfpush='git push -f'
alias gpull='git pull'
alias gfpull='git fetch && git pull'
alias gl='git log --oneline --decorate --all --graph'

# Lazygit
command -v lazygit &>/dev/null && alias lg='lazygit'

# Yarn
alias ydev='yarn dev'

# Utilities
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Tar flags
extract() {
    case "$1" in
        *.tar.gz|*.tgz)    tar xzf "$1" ;;
        *.tar.bz2|*.tbz2)  tar xjf "$1" ;;
        *.tar.xz)          tar xJf "$1" ;;
        *.tar.zst)         tar --zstd -xf "$1" ;;
        *.tar)             tar xf "$1"  ;;
        *.zip)             unzip "$1"   ;;
        *.7z)              7z x "$1"    ;;
        *.gz)              gunzip "$1"  ;;
        *.bz2)             bunzip2 "$1" ;;
        *.xz)              unxz "$1"    ;;
        *.zst)             zstd -d "$1" ;;
        *)                 echo "Unknown archive format: $1" ;;
    esac
}

# Pacman / paru — drift management
alias plist='pacman -Qe' 
alias pexp='pacman -Qe | awk "{print \$1}" | sort'
alias paur='pacman -Qm'
alias pupdt='sudo pacman -Syu'
alias padd='sudo pacman -S'
alias prm='sudo pacman -Rns'
alias pcls='sudo pacman -Sc'

pdiff() {
    # Compare explicitly installed pacman packages vs playbook inventory
    local playbook="${PLAYBOOK_DIR:-$HOME/Dev/personal/playbook}"
    pacman -Qe | awk '{print $1}' | sort > /tmp/pac_installed.txt
    grep -rh '^\s*-\s' "$playbook/roles/"{common,desktop,arch}"/tasks/main.yml" 2>/dev/null \
        | sed 's/^[[:space:]]*-[[:space:]]*//' | sort > /tmp/pac_playbook.txt
    echo "=== In system but not in playbook ==="
    comm -23 /tmp/pac_installed.txt /tmp/pac_playbook.txt
    echo ""
    echo "=== In playbook but not installed ==="
    comm -13 /tmp/pac_installed.txt /tmp/pac_playbook.txt
    rm /tmp/pac_installed.txt /tmp/pac_playbook.txt
}

# Network
alias myip='curl -s https://ifconfig.me'
alias ports='ss -tulnp'

# Disk
alias df='df -h'
alias du='du -sh'

# Systemd
alias sc='sudo systemctl'
alias scs='systemctl status'
alias scl='journalctl -xe'
